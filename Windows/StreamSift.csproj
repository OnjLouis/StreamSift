<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.3.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>StreamSift</Product>
    <Company>OnjLouis</Company>
    <StreamSiftUpdatePublicKey Condition="'$(StreamSiftUpdatePublicKey)' == ''">Assets/UpdatePublicKey.xml</StreamSiftUpdatePublicKey>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StreamSiftWindows7)' == 'true'">
    <TargetFramework>net6.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>6.0.36</RuntimeFrameworkVersion>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <Product>StreamSift for Windows 7 ($(RuntimeIdentifier))</Product>
    <DefineConstants>$(DefineConstants);STREAMSIFT_WINDOWS7</DefineConstants>
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(DefineConstants);STREAMSIFT_WINDOWS7_X86</DefineConstants>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <Target Name="CheckWindows7Architecture" BeforeTargets="PrepareForBuild"
    Condition="'$(StreamSiftWindows7)' == 'true' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'win-x86'">
    <Error Text="Build StreamSift for Windows 7 with the win-x86 or win-x64 runtime identifier." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <InternalsVisibleTo Include="StreamSift.WindowsTests" />
    <ProjectReference Include="../Vendor/Onj.SignedUpdater/Onj.SignedUpdater.csproj" />
    <EmbeddedResource Include="Assets/search.wav" LogicalName="StreamSift.Sounds.search.wav" />
    <EmbeddedResource Include="Assets/done.wav" LogicalName="StreamSift.Sounds.done.wav" />
    <EmbeddedResource Include="Assets/error.wav" LogicalName="StreamSift.Sounds.error.wav" />
    <EmbeddedResource Include="$(StreamSiftUpdatePublicKey)" LogicalName="StreamSift.UpdatePublicKey.xml" Condition="'$(StreamSiftUpdatePublicKey)' != ''" />
    <None Include="../Vendor/Onj.SignedUpdater/LICENSE" Link="SignedUpdater-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../Manual.html" Link="Manual.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../AngleSharp-LICENSE.txt" Link="AngleSharp-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
